/// One row per Favorita item, with the synthetic ERP unit price and unit cost.
table Item

	column ItemKey
		dataType: int64
		isHidden
		isAvailableInMdx: false
		formatString: 0
		summarizeBy: none
		sourceColumn: item_key

	column 'Item Number'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: item_nbr

	column Family
		dataType: string
		summarizeBy: none
		sourceColumn: family

	column Class
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: class

	column 'Is Perishable'
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_perishable

	column 'Unit Price'
		dataType: decimal
		formatString: \$#,0.00
		summarizeBy: none
		sourceColumn: unit_price

	column 'Unit Cost'
		dataType: decimal
		formatString: \$#,0.00
		summarizeBy: none
		sourceColumn: unit_cost

	partition Item = m
		mode: import
		source =
				let
				    Source = Sql.Database(SqlEndpoint, Lakehouse),
				    Data = Source{[Schema = "dbo", Item = "dim_item"]}[Data],
				    Result = Table.SelectColumns(Data, {"item_key", "item_nbr", "family", "class", "is_perishable", "unit_price", "unit_cost"})
				in
				    Result
