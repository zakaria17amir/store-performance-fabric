/// Store and regional managers: only the stores listed for them in User Access; unit cost (and so margin) is hidden.
role 'Store operations'
	modelPermission: read

	tablePermission Store = 'Store'[StoreKey] IN CALCULATETABLE(VALUES('User Access'[StoreKey]), 'User Access'[User Principal Name] = USERPRINCIPALNAME())

	tablePermission 'User Access' = 'User Access'[User Principal Name] = USERPRINCIPALNAME()

	tablePermission Item

		columnPermission 'Unit Cost' = none
