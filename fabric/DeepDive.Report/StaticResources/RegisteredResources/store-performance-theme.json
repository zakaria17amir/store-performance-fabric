{
  "name": "Store Performance",
  "dataColors": [
    "#2a78d6",
    "#eb6834",
    "#1baf7a",
    "#eda100",
    "#e87ba4",
    "#008300",
    "#4a3aa7",
    "#e34948"
  ],
  "foreground": "#0b0b0b",
  "foregroundNeutralSecondary": "#52514e",
  "foregroundNeutralTertiary": "#898781",
  "background": "#FFFFFF",
  "backgroundLight": "#eef2f8",
  "backgroundNeutral": "#c3c2b7",
  "tableAccent": "#1c5cab",
  "good": "#006300",
  "neutral": "#898781",
  "bad": "#d03b3b",
  "maximum": "#1c5cab",
  "center": "#f0efec",
  "minimum": "#e34948",
  "textClasses": {
    "callout": {
      "fontSize": 20,
      "fontFace": "Segoe UI Semibold",
      "color": "#0d366b"
    },
    "title": {
      "fontSize": 14,
      "fontFace": "Segoe UI Semibold",
      "color": "#0d366b"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#0b0b0b"
    },
    "label": {
      "fontSize": 11,
      "fontFace": "Segoe UI",
      "color": "#52514e"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#dde3ee"
              }
            },
            "radius": 8
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#0d366b"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#eef2f8"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#e8f1fc"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#b7d3f6"
              }
            },
            "radius": 8
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#1c5cab"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "values": [
          {
            "backColorSecondary": {
              "solid": {
                "color": "#f5f8fd"
              }
            }
          }
        ]
      }
    }
  }
}